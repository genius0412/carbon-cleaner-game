# ============================================================================
# Carbon Cleaner — environment variables
# Copy to .env.local and fill in. NEVER commit real keys.
# The game runs fully offline (localStorage) if Supabase vars are omitted.
# ============================================================================

# --- Supabase (Auth, Postgres, Realtime, Storage) ---
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public key (safe to expose to the browser). Provide ONE of the following —
# the app accepts either name:
#   - the newer "publishable" key (looks like sb_publishable_...), or
#   - the legacy "anon" key (a long JWT).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional: AI vision for the lenient civic-action proof check ---
# If set, the /api/civic-check route sends the screenshot to Claude for a
# loose "does this look like a climate email?" check. If omitted, a simple
# keyword check is used instead. Server-side only — do NOT prefix with NEXT_PUBLIC.
ANTHROPIC_API_KEY=
